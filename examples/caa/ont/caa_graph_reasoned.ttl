###  http://example.org/constraint_caa001a_d1
<http://example.org/constraint_caa001a_d1> rdf:type owl:NamedIndividual ,
                                                    <http://example.org/DistanceConstraint> ,
                                                    <http://purl.org/gc/Value> ,
                                                    rdfs:Class ;
                                           <http://example.org/involvesAtom1> <http://example.org/atom_4> ;
                                           <http://example.org/involvesAtom2> <http://example.org/atom_13> ;
                                           <http://purl.org/gc/hasUnit> <http://purl.org/gc/angstrom> ;
                                           <http://example.org/targetValue> "2.0"^^xsd:float ;
                                           <http://purl.org/gc/constraintMode> "fixed" ;
                                           rdfs:label "Distance constraint caa001a (atoms 4-13)" .


