                                                 <http://example.org/hasRuntyp> "OPTIMIZE" ;
                                                 rdfs:label "Vibrational analysis caa005bIRC-def2svp-test" ;
                                                 <http://www.w3.org/2004/02/skos/core#editorialNote> "fresh def2-SVP basis (verified byte-for-byte vs Basis Set Exchange); crashed \"DGEMM parameter 13 illegal value\" before the first SCF cycle" .


###  http://example.org/exp_caa005bIRC-pcseg2-test
<http://example.org/exp_caa005bIRC-pcseg2-test> rdf:type owl:NamedIndividual ,
                                                         <http://purl.org/gc/Atom> ,
                                                         <http://purl.org/gc/MolecularComputation> ,
                                                         <http://purl.org/gc/MolecularMethodology> ,
                                                         <http://purl.org/gc/VibrationalAnalysis> ,
                                                         <http://www.w3.org/ns/prov#Activity> ;
                                                <http://www.w3.org/ns/prov#generated> <http://example.org/file_caa005bIRC-pcseg2-test_dat> ,
                                                                                      <http://example.org/file_caa005bIRC-pcseg2-test_log> ;
                                                <http://www.w3.org/ns/prov#used> <http://example.org/file_caa005bIRC-pcseg2-test_inp> ;
                                                <http://purl.org/gc/hasBasisSet> "Custom/mixed basis (BASNAM) - see input file" ;
                                                <http://purl.org/gc/hasMethod> "wB97X-D" ;
                                                <http://example.org/hasHssend> "true"^^xsd:boolean ;
                                                <http://example.org/hasRuntyp> "OPTIMIZE" ;
                                                rdfs:label "Vibrational analysis caa005bIRC-pcseg2-test" ;
                                                <http://www.w3.org/2004/02/skos/core#editorialNote> "native GBASIS=PCSEG-2 instead of custom def2-TZVPP; converged cleanly to the chemically correct energy (-766.37 vs def2-TZVPP's wrong -491.67 at the same geometry), zero imaginary frequencies -- resolved the whole saga: custom BASNAM/EXTFIL basis construction was broken on this ARCHER2 build, never a real chemical instability. Note RUNTYP was accidentally OPTIMIZE, not a strict single point" .


