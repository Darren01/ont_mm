     SOSCF=.T.
     DAMP=.F.
     SHIFT=.T.
 $END
 $STATPT OPTTOL=0.0001 NSTEP=300 IHREP=20 HSSEND=.T. DXMAX=0.10 $END
 $ZMAT DLC=.T. AUTO=.T.
      NONVDW(1)=8,13,10,7,7,3,8,10
 $END
 $FORCE METHOD=SEMINUM PROJCT=.T. $END
 $PCM SOLVNT=WATER $END
 $SYSTEM MWORDS=100 MEMDDI=200 $END
 $CONTRL EXETYP=CHECK $END

