! C2H7O3Cl | Equilibrium Geometry | 3-21G
! Constraints applied to start nucleophilic attack at carbonyl
 $BASIS GBASIS=N21 NGAUSS=3 $END
 $CONTRL SCFTYP=RHF RUNTYP=OPTIMIZE NZVAR=33 $END
 $CONTRL DFTTYP=wB97X-D $END
 $STATPT OPTTOL=0.0005 NSTEP=200 IHREP=20 HSSEND=.t. $END
 $ZMAT DLC=.t. AUTO=.t. $END
 $ZMAT NONVDW(1)=4,13, 13,11, 11,10, 10,8, 8,3 $END
 $ZMAT IFZMAT(1)=1,4,13, 1,11,10, 1,8,3 FVALUE(1)=2.0, 2.0, 3.6 $END
 $FORCE METHOD=SEMINUM $END
 $PCM SOLVNT=WATER $END
 $SYSTEM MWORDS=25 MEMDDI=24 $END
!$CONTRL EXETYP=CHECK $END

 $DATA
