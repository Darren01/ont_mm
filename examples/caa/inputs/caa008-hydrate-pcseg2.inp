O     8.0      2.5603087480     2.2106662808    -2.3754643346
H     1.0      1.6709693090     0.0283936781    -1.3770177644
H     1.0      3.2228298935    -0.8588459724    -1.3540717760
O     8.0      3.2040687673     0.3605049482    -3.6242011489
H     1.0      2.2669603475     0.2417432648    -3.8244088890
H     1.0      4.3664826713     1.2059384076    -2.2399188577
H     1.0      2.9761761111     2.8251380864    -2.9906785419
 $END
