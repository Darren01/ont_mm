! C2H7O3Cl | caa007a-pcseg2: SINGLE POINT at wB97X-D/PCseg-2/PCM(water)
!
! Final step of the 3-point IRC refinement (caa007a/caa007b/caa005bTSb).
! Single-point energy (RUNTYP=ENERGY, no optimization) at the confirmed
! wB97X-D/6-31G(d,p)/PCM(water) minimum for the FIRST IRC point (Reaction
! Coordinate -200 of caa005bIRC.cml), geometry taken from
! caa005bIRCCML1st-prerelax-631Gdp.log (EXECUTION TERMINATED NORMALLY,
! zero imaginary frequencies -- confirmed genuine minimum).
!
! Native GBASIS=PCSEG-2 (Jensen's Polarization Consistent family, ~TZ2P,
! roughly cc-pVTZ-equivalent) -- confirmed to sidestep entirely the
! DGEMM crash affecting custom BASNAM/EXTFIL bases on this ARCHER2 build
! (see gamess-dgemm-bug-report.md), and confirmed to give a chemically
! sensible energy where custom def2-TZVPP did not (caa005bIRC-pcseg2-test).
! ISPHER=1 is mandatory for this basis family (confirmed in docs-input.txt).

 $CONTRL SCFTYP=RHF RUNTYP=ENERGY DFTTYP=wB97X-D
         COORD=UNIQUE MAXIT=200 NOSYM=1 ISPHER=1
 $END
 $GUESS GUESS=HUCKEL $END
 $BASIS GBASIS=PCSEG-2 $END
 $SCF CONV=1.0D-6
     SOSCF=.T.
     DAMP=.F.
     SHIFT=.T.
     DIRSCF=.TRUE.
 $END
 $PCM SOLVNT=WATER $END
 $SYSTEM MWORDS=100 MEMDDI=200 $END

 $DATA
