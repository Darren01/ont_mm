! C2H8O3 | aa001h-smd-pcseg2: SINGLE POINT at wB97X-D/PCseg-2/SMD(water)
!
! Single-point energy for the aldehyde-side endpoint, geometry from
! aa001h-smd.log (EXECUTION TERMINATED NORMALLY). See aa001d-smd-pcseg2.inp
! for full recipe notes.

 $CONTRL SCFTYP=RHF RUNTYP=ENERGY DFTTYP=wB97X-D
         COORD=UNIQUE MAXIT=200 NOSYM=1 ISPHER=1
 $END
 $GUESS GUESS=HUCKEL $END
 $BASIS GBASIS=PCSEG-2 $END
 $SCF CONV=1.0D-6
     SOSCF=.T.
     DAMP=.F.
     SHIFT=.T.
     DIRSCF=.TRUE.
 $END
 $PCM SOLVNT=WATER SMD=.T. $END
 $SYSTEM MWORDS=100 MEMDDI=200 $END

