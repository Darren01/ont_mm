! C2H8O3 | aa001-ts-pcseg2: SINGLE POINT at wB97X-D/PCseg-2/PCM(water)
!
! Single-point energy (RUNTYP=ENERGY, no optimization) at the genuine,
! unconstrained acetaldehyde-hydration saddle point located in aa001d.log
! (NSERCH=8, SADDLE POINT LOCATED, exactly one imaginary frequency
! 1360.89i, all six trans/rot modes cleanly at 0.00 thanks to correct use
! of $FORCE PURIFY=.T.).
!
! Native GBASIS=PCSEG-2, ISPHER=1 mandatory -- same recipe validated
! throughout the chloroacetaldehyde work.

 $CONTRL SCFTYP=RHF RUNTYP=ENERGY DFTTYP=wB97X-D
         COORD=UNIQUE MAXIT=200 NOSYM=1 ISPHER=1
 $END
 $GUESS GUESS=HUCKEL $END
 $BASIS GBASIS=PCSEG-2 $END
 $SCF CONV=1.0D-6
     SOSCF=.T.
     DAMP=.F.
     SHIFT=.T.
     DIRSCF=.TRUE.
 $END
 $PCM SOLVNT=WATER $END
 $SYSTEM MWORDS=100 MEMDDI=200 $END

 $DATA
Acetaldehyde hydrate and water -- TS, single point at PCseg-2
