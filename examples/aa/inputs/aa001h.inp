! C2H8O3 | Unconstrained optimization of backward-IRC endpoint
! wB97X-D/6-21G+(d,p)/PCM(water) -- see aa001g.inp for full provenance
! notes (same level throughout, no $HESS needed, PURIFY correctly in
! $FORCE). Only difference: starting geometry is the final point reached
! by the BACKWARD IRC run (aa001f.log), the opposite endpoint of the
! reaction path.

 $BASIS GBASIS=N21 NGAUSS=6 NDFUNC=1 NPFUNC=1 DIFFSP=.t. $END
 $CONTRL SCFTYP=RHF RUNTYP=OPTIMIZE NZVAR=33 $END
 $CONTRL DFTTYP=wB97X-D $END
 $SCF DIIS=.t. DAMP=.t. $END
 $STATPT OPTTOL=0.00005 NSTEP=200 IHREP=20 HSSEND=.t. $END
 $ZMAT DLC=.t. AUTO=.t. $END
 $ZMAT NONVDW(1)=8,13, 10,7, 7,3, 8,10 $END
 $FORCE METHOD=SEMINUM PURIFY=.t. $END
 $PCM SOLVNT=WATER $END
 $SYSTEM MWORDS=25 MEMDDI=24 $END
!$CONTRL EXETYP=CHECK $END

 $DATA
Acetaldehyde hydrate and water -- backward IRC endpoint, unconstrained opt
