! C2H8O3 | aa001d-smd-pcseg2: SINGLE POINT at wB97X-D/PCseg-2/SMD(water)
!
! Single-point energy (RUNTYP=ENERGY, no optimization) at the genuine
! SMD-embedded saddle point located in aa001d-smd.log (NSERCH=5, SADDLE
! POINT LOCATED, exactly one imaginary frequency 1248.16i, all six
! trans/rot modes cleanly at 0.00).
!
! Native GBASIS=PCSEG-2, ISPHER=1 mandatory. SMD=.T. added to $PCM for
! consistency with the SMD-optimized geometry -- avoiding mixing an
! SMD-optimized structure with a plain-PCM single-point energy.

 $CONTRL SCFTYP=RHF RUNTYP=ENERGY DFTTYP=wB97X-D
         COORD=UNIQUE MAXIT=200 NOSYM=1 ISPHER=1
 $END
 $GUESS GUESS=HUCKEL $END
 $BASIS GBASIS=PCSEG-2 $END
 $SCF CONV=1.0D-6
     SOSCF=.T.
     DAMP=.F.
     SHIFT=.T.
     DIRSCF=.TRUE.
 $END
 $PCM SOLVNT=WATER SMD=.T. $END
 $SYSTEM MWORDS=100 MEMDDI=200 $END

 $DATA
Acetaldehyde hydrate and water -- TS, SMD single point at PCseg-2
C1
