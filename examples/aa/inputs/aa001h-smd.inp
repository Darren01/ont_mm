! C2H8O3 | SMD variant: unconstrained re-optimization of aldehyde-side endpoint
! wB97X-D/6-21G+(d,p)/SMD(water). See aa001g-smd.inp/
! aa002-aldehyde-bare-smd.inp for full provenance notes.
!
! Starting geometry: the previously-converged plain-PCM aa001h structure
! (confirmed via bond-length analysis to be the genuine ALDEHYDE -- intact
! C3=O4 double bond).

 $BASIS GBASIS=N21 NGAUSS=6 NDFUNC=1 NPFUNC=1 DIFFSP=.t. $END
 $CONTRL SCFTYP=RHF RUNTYP=OPTIMIZE NZVAR=33 $END
 $CONTRL DFTTYP=wB97X-D $END
 $SCF DIIS=.t. DAMP=.t. $END
 $STATPT OPTTOL=0.00005 NSTEP=200 IHREP=20 HSSEND=.t. $END
 $ZMAT DLC=.t. AUTO=.t. $END
 $ZMAT NONVDW(1)=8,13, 10,7, 7,3, 8,10 $END
 $FORCE METHOD=SEMINUM PURIFY=.t. $END
 $PCM SOLVNT=WATER SMD=.T. $END
 $SYSTEM MWORDS=25 MEMDDI=24 $END
!$CONTRL EXETYP=CHECK $END

 $DATA
