! C2H8O3 | aa001g-pcseg2: SINGLE POINT at wB97X-D/PCseg-2/PCM(water)
!
! Single-point energy (RUNTYP=ENERGY, no optimization) at the confirmed
! genuine minimum from the forward IRC endpoint, geometry taken from
! aa001g.log (EXECUTION TERMINATED NORMALLY, zero imaginary frequencies,
! all six trans/rot modes cleanly at 0.00).
!
! Native GBASIS=PCSEG-2, ISPHER=1 mandatory -- same recipe used
! throughout this project.

 $CONTRL SCFTYP=RHF RUNTYP=ENERGY DFTTYP=wB97X-D
         COORD=UNIQUE MAXIT=200 NOSYM=1 ISPHER=1
 $END
 $GUESS GUESS=HUCKEL $END
 $BASIS GBASIS=PCSEG-2 $END
 $SCF CONV=1.0D-6
     SOSCF=.T.
     DAMP=.F.
     SHIFT=.T.
     DIRSCF=.TRUE.
 $END
 $PCM SOLVNT=WATER $END
 $SYSTEM MWORDS=100 MEMDDI=200 $END

 $DATA
