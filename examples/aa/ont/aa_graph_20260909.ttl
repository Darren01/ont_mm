                                                   <http://purl.org/gc/VibrationalAnalysis> ;
                                          <http://purl.org/gc/hasResult> <http://example.org/energies_aa002-water-bare> ,
                                                                         <http://example.org/spectrum_aa002-water-bare> ;
                                          <http://www.w3.org/ns/prov#generated> <http://example.org/file_aa002-water-bare_dat> ,
                                                                                <http://example.org/file_aa002-water-bare_log> ;
                                          <http://www.w3.org/ns/prov#used> <http://example.org/file_aa002-water-bare_inp> ;
                                          <http://purl.org/gc/hasBasisSet> "6-21G+(d,p)" ;
                                          <http://purl.org/gc/hasMethod> "wB97X-D" ;
                                          <http://example.org/hasHssend> "true"^^xsd:boolean ;
                                          <http://example.org/hasRuntyp> "OPTIMIZE" ;
                                          <http://example.org/hasSolvationModel> "PCM" ;
                                          <http://example.org/hasSolvent> "water" ;
                                          rdfs:label "Vibrational analysis aa002-water-bare" ;
                                          <http://www.w3.org/2004/02/skos/core#editorialNote> "geometry+frequency optimization of a STANDALONE water molecule (3 atoms, NZVAR=3); first attempt used the wrong H (O8/H9/H10, where H10 is actually bonded to O7 not O8 -- GAMESS's own error message caught this: \"NOT ENOUGH PRIMITIVE INTERNAL COORDINATES\"). Corrected to O8/H9/H13 (confirmed by direct O-H distance checks, 0.961 A and 0.981 A); converged cleanly, sensible frequencies (1535.62, 3832.92, 3971.16 cm-1: bend, sym stretch, asym stretch)" .


