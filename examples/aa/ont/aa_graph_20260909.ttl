                                              "A property that describes handling of spins by the methodology (RHF,UHF,ROHF)."@en ;
                                 rdfs:isDefinedBy <http://chemicalsemantics.com/> ;
                                 rdfs:label "has spin type"@en .


<http://purl.org/gc/hasSystemMultiplicity> rdfs:comment """The spin multiplicity of the molecular system, 
    	    defined as 2S+1 where S is the total spin. Singlet=1, doublet=2, triplet=3 etc.  
    	    Always a positive integer."""@en ;
                                           rdfs:isDefinedBy <http://chemicalsemantics.com/> ;
                                           rdfs:label "has system multiplicity"@en .


<http://purl.org/gc/hasTag> rdfs:comment "A property that reports tags assigned to publication"@en ;
                            rdfs:label "Tag for the calculation"@en .


<http://purl.org/gc/hasTextValue> rdfs:comment "A property ..."@en ;
                                  rdfs:label "Text Value"@en .


<http://purl.org/gc/hasTransitionCount> rdfs:comment "A property that describes the number of the electronic transitions in spectral calculations."@en ;
                                        rdfs:isDefinedBy <http://chemicalsemantics.com/> ;
                                        rdfs:label "has transition count"@en .


<http://purl.org/gc/hasUnoccupiedOrbitalsIncluded> rdfs:comment "A property that describes the inclusion of occupied orbitals in electronic spectra calculations."@en ;
                                                   rdfs:isDefinedBy <http://chemicalsemantics.com/> ;
                                                   rdfs:label "has unoccupied orbitals included"@en .


<http://purl.org/gc/hasVibrationCount> rdfs:comment "A property that describes the number of vibrational frequencies."@en ;
                                       rdfs:isDefinedBy <http://chemicalsemantics.com/> ;
                                       rdfs:label "has vibration count"@en .


