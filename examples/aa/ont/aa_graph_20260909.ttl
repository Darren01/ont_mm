                                  rdfs:subClassOf <http://purl.org/gc/CalculationResult> ;
                                  <http://purl.obolibrary.org/obo/IAO_0000115> "A minimum-energy reaction path on a potential energy surface in mass-weighted coordinates, connecting reactants to products via the transition state."@en ;
