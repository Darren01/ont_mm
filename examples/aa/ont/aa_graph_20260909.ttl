###  http://purl.org/gc/hasVibrationCount
<http://purl.org/gc/hasVibrationCount> rdf:type owl:DatatypeProperty ,
                                                owl:FunctionalProperty .


###  http://purl.org/gc/hasVisibility
<http://purl.org/gc/hasVisibility> rdf:type owl:DatatypeProperty ;
                                   rdfs:subPropertyOf <http://purl.org/gc/hasPublicationData> ;
                                   rdfs:domain <http://purl.org/gc/ComputationalChemistryPublication> ;
                                   rdfs:range xsd:string ;
                                   rdfs:comment "A property that defines the allowed visibility of the publication."@en ;
                                   rdfs:isDefinedBy <http://chemicalsemantics.com/> ;
                                   rdfs:label "has visibility"@en .


###  http://www.theworldavatar.com/ontology/ontopesscan/OntoPESScan.owl#hasInputAtomIds
<http://www.theworldavatar.com/ontology/ontopesscan/OntoPESScan.owl#hasInputAtomIds> rdf:type owl:DatatypeProperty ;
                                                                                     rdfs:domain <http://www.theworldavatar.com/ontology/ontopesscan/OntoPESScan.owl#ScanPoint> ;
                                                                                     rdfs:range xsd:string ;
                                                                                     <http://purl.org/dc/terms/source> "Menon et al. 2023, ACS Omega 8(2), 2462-2475, DOI: 10.1021/acsomega.2c06948"@en ;
                                                                                     rdfs:comment "The raw atom index numbers as actually used in this specific scan point's own input file - deliberately not treated as a canonical, cross-geometry atom identity, since numbering can genuinely vary from point to point (the same real-world caveat raised during Stage A about atom indices not matching IUPAC numbering)."@en ;
                                                                                     rdfs:label "has input atom ids"@en .


