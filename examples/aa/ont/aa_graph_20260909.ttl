###  http://purl.org/gc/hasVersion
<http://purl.org/gc/hasVersion> rdf:type owl:DatatypeProperty ;
                                rdfs:subPropertyOf <http://purl.org/gc/hasPublicationData> ;
                                rdfs:domain <http://purl.org/gc/SourcePackage> ;
                                rdfs:range xsd:string ;
                                rdfs:comment "A property that describes the version of the software package used."@en ;
                                rdfs:isDefinedBy <http://chemicalsemantics.com/> ;
