                              rdfs:domain <http://purl.org/gc/Value> ;
                              rdfs:range rdfs:Literal ;
                              rdfs:comment "A Superproperty of typed numerical values."@en ;
                              rdfs:isDefinedBy <http://chemicalsemantics.com/> ;
                              rdfs:label "has value"@en .


###  http://purl.org/gc/hasVectorValue
<http://purl.org/gc/hasVectorValue> rdf:type owl:DatatypeProperty ;
                                    rdfs:subPropertyOf <http://purl.org/gc/hasValue> ;
                                    rdf:type owl:FunctionalProperty ;
                                    rdfs:domain <http://purl.org/gc/VectorValue> ;
                                    rdfs:range rdfs:Literal ;
                                    rdfs:comment "A property that describes the vector values."@en ;
                                    rdfs:isDefinedBy <http://chemicalsemantics.com/> ;
