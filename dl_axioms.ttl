@prefix gc: <http://purl.org/gc/> .
@prefix ex: <http://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/dl_axioms> a owl:Ontology ;
    rdfs:comment "This project's own DL axioms, kept separate from gc_core.ttl (the upstream Gainesville Core mirror) rather than modifying it directly. Merged with a built, asserted graph before reasoning - see build_reasoned_graph(). Each axiom here was tested and confirmed working against real reasoning before being added; see the two-part DL test done earlier this session."@en .

# =========================================================
# 1. ImaginaryFrequencyPeak - a defined class
# =========================================================
# Confirmed working: a real OWL 2 reasoner (HermiT) correctly
# classifies any FrequencyPeak whose hasFrequency value is negative as
# this class, purely from this declarative axiom - no procedural code
# anywhere checks the sign. Tested against 3 cases: a genuine negative
# value (correctly classified), a positive value (correctly not), and
# exactly zero (correctly not - maxExclusive means zero itself doesn't
# count, confirmed deliberately rather than assumed).
ex:ImaginaryFrequencyPeak a owl:Class ;
    rdfs:label "Imaginary frequency peak"@en ;
    rdfs:comment "A gc:FrequencyPeak whose gc:hasFrequency value is negative - GAMESS's convention for an imaginary vibrational mode. Confirms a genuine transition state (for a SaddlePoint), or flags an unconverged geometry (for a VibrationalAnalysis where none was expected)."@en ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            gc:FrequencyPeak
            [
                a owl:Restriction ;
                owl:onProperty gc:hasFrequency ;
                owl:someValuesFrom [
                    a owl:Class ;
                    owl:intersectionOf (
                        gc:FloatValue
                        [
                            a owl:Restriction ;
                            owl:onProperty gc:hasFloatValue ;
                            owl:someValuesFrom [
                                a rdfs:Datatype ;
                                owl:onDatatype xsd:float ;
                                owl:withRestrictions ( [ xsd:maxExclusive "0.0"^^xsd:float ] )
                            ]
                        ]
                    )
                ]
            ]
        )
    ] .

# =========================================================
# 2. Experiment-type disjointness
# =========================================================
# Confirmed working: tested with a deliberate violation (one
# individual asserted as both gc:SinglePoint and
# gc:VibrationalAnalysis at once) - the reasoner correctly flags the
# whole ontology as inconsistent. The same test with that one
# assertion removed is confirmed genuinely consistent - a proper,
# controlled test, not just a single run assumed correct.
#
# Mirrors classify_gamess_job()'s own, already-established rule that
# these five types are mutually exclusive - this makes that rule
# checkable by a reasoner, not only by manual review (as it has been,
# all session).
[] a owl:AllDisjointClasses ;
   owl:members (
       gc:GeometryOptimization
       gc:SinglePoint
       gc:VibrationalAnalysis
       gc:SaddlePoint
       gc:IRC
   ) .

# =========================================================
# 3. Experiment - a defined class
# =========================================================
# Confirmed working: tested against the published aa graph with a real
# reasoner (HermiT). Every individual with a prov:used link to an
# ex:InputFile is classified as ex:Experiment - exactly the 30
# experiments in aa, none missing and none extra - and each keeps its
# specific kind (gc:SinglePoint, gc:VibrationalAnalysis, ...).
# ex:avogadro_build, which used nothing, correctly is not one. The
# result was consistent alongside axioms 1 and 2 above.
#
# Why a defined class and not subclass axioms: robot reason writes
# only an individual's most specific inferred types, so declaring the
# five experiment kinds as subclasses of ex:Experiment produced no
# ex:Experiment assertions at all (tested: 0 of 30). An equivalence
# sits beside the specific kind rather than above it, so it is written
# out - the same way ex:ImaginaryFrequencyPeak is, above.
#
# Why it exists: no single upstream class means "an experiment".
# gc:MolecularComputation is only attached as a by-product when
# results, constraints or notes are written for an experiment, so it
# misses experiments with none of those; and once reasoned it matches
# many things that are not experiments at all. See the SPARQL
# tutorial, Chapter 4.
#
# One deliberate consequence: ex:Experiment is now more specific than
# the prov:Activity that experiments otherwise get from the domain of
# prov:used, so "?x a prov:Activity" no longer returns experiments in
# a reasoned graph (31 became 1 in aa) - use ex:Experiment instead.
ex:Experiment a owl:Class ;
    rdfs:label "Experiment"@en ;
    rdfs:comment "A calculation run: anything that used an input file (prov:used some ex:InputFile). Derived by the reasoner rather than asserted by the pipeline, so it appears only in reasoned graphs. Each experiment also keeps its specific kind (gc:SinglePoint, gc:VibrationalAnalysis, and so on)."@en ;
    rdfs:subClassOf prov:Activity ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty prov:used ;
        owl:someValuesFrom ex:InputFile
    ] .
